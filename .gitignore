# ============================================================================
# VirtualApp .gitignore
# ============================================================================

# ---- Gradle ----
.gradle/
build/
release/
test-apks/
# Note: gradlew / gradlew.bat / gradle/wrapper/* 必须纳入版本库，不要忽略

# ---- Android Studio / IntelliJ ----
.idea/
*.iml
captures/
.navigation/
vcs.xml

# ---- Native build outputs ----
.externalNativeBuild/
.cxx/

# ---- Local config (machine-specific) ----
local.properties

# ---- Built artifacts ----
*.ap_
*.aab
*.dex
*.class
*.so
# commonSdk 的预编译 native 库需要入库
!commonSdk/src/main/jniLibs/**/*.so
bin/
gen/
out/

# ---- ProGuard outputs ----
proguard/
security/mapping.txt

# ---- Security / signing (do not commit) ----
security/*.jks
security/*.keystore
security/*.jks.old.bak
security/dic.txt
security/proguard-rules.pro

# ---- Logs ----
*.log
build.log

# ---- OS metadata ----
.DS_Store

# ---- AI tooling (machine-local) ----
.claude/
